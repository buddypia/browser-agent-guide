{
  "name": "browser-agent-guide",
  "version": "0.1.0",
  "description": "Guardrails that keep browser-operating AIs on track — a Chrome side-panel agent that drives any page through a closed, deterministic verb registry using Structured Outputs.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "buddypia",
  "homepage": "https://github.com/buddypia/browser-agent-guide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buddypia/browser-agent-guide.git"
  },
  "bugs": {
    "url": "https://github.com/buddypia/browser-agent-guide/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "side-panel",
    "ai-agent",
    "browser-agent",
    "browser-automation",
    "structured-outputs",
    "llm",
    "openai",
    "anthropic",
    "deterministic"
  ],
  "scripts": {
    "postinstall": "node .claude/scripts/setup-skills.mjs",
    "check": "npm run check:fast && npm run test:guard && npm run test:e2e",
    "check:fast": "node scripts/run-checks.mjs check:js check:harness check:sync check:markers check:glossary glossary:staleness test:glossary test:slug test:recipe test:prompt test:workflow-lib test:eg2 test:judge test:ai-client test:agent-verbs test:ship test:agy-hooks test:harness test:pf",
    "test:e2e": "npm test && npm run test:ui",
    "test:guard": "python3 scripts/agent-worktree-guard/test_guard.py",
    "check:js": "node scripts/check-js.mjs",
    "check:harness": "node scripts/check-harness.mjs",
    "harness:index": "node scripts/harness-library.mjs",
    "check:sync": "node scripts/check-sync-pairs.mjs",
    "check:markers": "node scripts/check-agent-markers.mjs",
    "check:glossary": "node scripts/glossary/validate.mjs",
    "test:glossary": "node --test 'test/glossary/*.test.mjs'",
    "glossary:trace": "node scripts/glossary/build-traceability.mjs",
    "glossary:touch": "node scripts/glossary/touch.mjs",
    "glossary:staleness": "node scripts/glossary/check-staleness.mjs",
    "test": "node test/anchor.playwright-cli.mjs",
    "test:slug": "node test/slug.test.mjs",
    "test:recipe": "node test/recipe-merge.test.mjs",
    "test:prompt": "node test/prompt.test.mjs",
    "test:workflow-lib": "node test/workflow-lib.test.mjs",
    "test:eg2": "node test/eg2-client.test.mjs",
    "test:judge": "node test/judge-client.test.mjs",
    "test:ai-client": "node test/ai-client.test.mjs",
    "test:agent-verbs": "node test/agent-verbs.test.mjs",
    "test:ship": "node --test test/auto-ship.test.mjs test/cleanup-merged-branches.test.mjs",
    "test:agy-hooks": "node --test test/antigravity-hooks.test.mjs",
    "test:harness": "node --test test/check-harness.test.mjs test/harness-library.test.mjs",
    "test:pf": "node test/page-feedback/compositor.test.mjs",
    "test:ui": "playwright test -c playwright.config.mjs",
    "debug:playground": "node scripts/debug-with-extension.mjs",
    "read-annotations": "node scripts/read-annotations-cdp.mjs",
    "zip": "./package-extension.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
